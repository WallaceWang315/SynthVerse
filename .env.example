# Optional chat-completions-compatible provider. Empty URL enables the labelled local rule demo.
MODEL_CHAT_URL=
MODEL_NAME=
MODEL_API_KEY=
# agent: bounded tool loop (provider must support tools); direct: structured-output comparison baseline.
MODEL_EXECUTION_MODE=agent
# Local example: MODEL_CHAT_URL=http://127.0.0.1:11434/v1/chat/completions
# MODEL_NAME must be a model already installed in the chosen provider.
